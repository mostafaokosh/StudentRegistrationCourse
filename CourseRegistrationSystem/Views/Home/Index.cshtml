@{
    ViewData["Title"] = "Home Page";
}

<h2>Student Registration</h2>
@if (Model.Status == CourseRegistrationSystem.Models.StatusEnum.Success)
{
    <div class="alert alert-success text-center">
        @Model.Message
    </div>
}
else if (Model.Status == CourseRegistrationSystem.Models.StatusEnum.AlreadyExists)
{
    <div class="alert alert-warning text-center">
        @Model.Message
    </div>
}
else if (Model.Status == CourseRegistrationSystem.Models.StatusEnum.Failed)
{
    <div class="alert alert-danger text-center">
        @Model.Message
    </div>
}

@model CourseRegistrationSystem.Models.StudentResponse

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4">
                    <h2 class="text-center mb-4">Student Registration</h2>

                    <form method="post" asp-action="SubmitData">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">First Name</label>
                                <input type="text" name="FirstName" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Last Name</label>
                                <input type="text" name="LastName" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Phone Number</label>
                                <input type="text" name="PhoneNumber" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Email Address</label>
                                <input type="text" name="EmailAddress" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Course Name</label>
                                <input type="text" name="CourseName" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Level</label>
                                <select name="Level" class="form-control">
                                    <option value="">-- Select Level --</option>
                                    <option value="Beginner">Beginner</option>
                                    <option value="Intermediate">Intermediate</option>
                                    <option value="Advanced">Advanced</option>
                                </select>
                            </div>
                        </div>

                        <div class="text-center mt-3">
                            <button type="submit" class="btn btn-primary px-4">Register</button>
                        </div>
                    </form>
                    @if (Model.Students.Any())
                    {
                        <div class="container mt-4">
                            <div class="card shadow-sm border-0 rounded-4">
                                <div class="card-body p-4">
                                    <h3 class="mb-3">Registered Students</h3>

                                    <div class="table-responsive">
                                        <form method="get" asp-action="Index" class="mb-3 d-flex gap-2">

                                            <input type="text" name="search" placeholder="Search by name or email"
                                                   class="form-control w-25" />

                                            <select name="courseFilter" class="form-control w-25">
                                                <option value="">All Courses</option>
                                                <option value="ASP.NET">ASP.NET</option>
                                                <option value="C#">C#</option>
                                                <option value="SQL">SQL</option>
                                            </select>

                                            <button type="submit" class="btn btn-secondary">Search</button>

                                        </form>
                                        <table class="table table-bordered table-hover align-middle">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>#</th>
                                                    <th>First Name</th>
                                                    <th>Last Name</th>
                                                    <th>Phone Number</th>
                                                    <th>Email Address</th>
                                                    <th>Course Name</th>
                                                    <th>Level</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < Model.Students.Count; i++)
                                                {
                                                    <tr>
                                                        <td>@(i + 1)</td>
                                                        <td>@Model.Students[i].FirstName</td>
                                                        <td>@Model.Students[i].LastName</td>
                                                        <td>@Model.Students[i].PhoneNumber</td>
                                                        <td>@Model.Students[i].EmailAddress</td>
                                                        <td>@Model.Students[i].CourseName</td>
                                                        <td>@Model.Students[i].Level</td>
                                                        <td>
                                                            <form method="post" asp-action="DeleteStudent">
                                                                <input type="hidden" name="email" value="@Model.Students[i].EmailAddress" />
                                                                <input type="hidden" name="course" value="@Model.Students[i].CourseName" />
                                                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>